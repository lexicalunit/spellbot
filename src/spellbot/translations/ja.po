msgstr "ユーザー <@ %(role)s > からロール%(user_id)s を取ることができません"

#, python-format
msgctxt "lfg.mythic_track"
msgid "Track your game on %(emoji)s[Mythic Track](%(link)s) with PIN code: `%(pin)s`"
msgstr "%(emoji)s[Mythic Track](%(link)s) でゲームを追跡できます。PIN コード：`%(pin)s`"

msgctxt "button.join"
