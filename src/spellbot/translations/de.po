msgctxt "game.title.ready"
msgid "**Your game is ready!**"
msgstr "**Ihr Spiel ist bereit!**"

msgctxt "game.title.rematch"
msgid "**Rematch Game!**"
msgstr "**Spiel wiederholen!**"

#, python-format
msgctxt "game.title.waiting"
msgid "**Waiting for %(count)s more player to join...**"
msgid_plural "**Waiting for %(count)s more players to join...**"
msgstr[0] "**Warte darauf, dass %(count)s weiterer Spieler beitritt …**"
msgstr[1] "**Warte darauf, dass %(count)s weitere Spieler beitreten …**"

msgctxt "game.description.check_dm"
msgid "Please check your Direct Messages for your game details."
msgstr "Ihre Spieldetails können Sie in Ihren Direktnachrichten finden."

msgctxt "game.description.rematch_info"
msgid "This is a rematch of a previous game. Please continue using the same game lobby and voice channel."
msgstr "Dies ist eine Wiederholung eines früheren Spiels. Verwenden Sie bitte weiterhin dieselbe Spielelobby und denselben Sprachkanal."

#, python-format
msgctxt "game.description.join_link"
msgid "# [Join your %(service)s game now!](%(link)s)"
msgstr "# [Treten Sie jetzt Ihrem %(service)s-Spiel bei!](%(link)s)"

#, python-format
msgctxt "game.description.link_error"
msgid "Sorry but SpellBot was unable to create a link for this game. Please go to [%(service)s](%(url)s) to create one."
msgstr "Leider konnte SpellBot keinen Link für dieses Spiel erstellen. Rufen Sie bitte [%(service)s](%(url)s) auf, um einen zu erstellen."

#, python-format
msgctxt "game.description.use_service"
msgid "Please use %(service)s to play this game."
msgstr "Verwenden Sie bitte %(service)s, um dieses Spiel zu spielen."

