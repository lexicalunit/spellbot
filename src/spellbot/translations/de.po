msgctxt "game.description.voice_available"
msgid "## Please consider using this available voice channel: <#%(channel_id)s>."
msgstr "## Ziehen Sie bitte in Erwägung, diesen verfügbaren Sprachkanal zu verwenden: <#%(channel_id)s>."

