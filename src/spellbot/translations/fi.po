msgctxt "game.field.players"
msgid "Players"
msgstr "Pelaajat"

#, python-format
msgctxt "game.field.players_hidden"
msgid "**%(count)s player name is hidden**"
msgid_plural "**%(count)s player names are hidden**"
msgstr[0] "**%(count)s pelaajan nimi on piilotettu**"
msgstr[1] "**%(count)s pelaajan nimet on piilotettu**"

msgctxt "game.field.format"
msgid "Format"
msgstr "Formaatti"

msgctxt "game.field.bracket"
msgid "Bracket"
msgstr "Taso"

msgctxt "game.field.started_at"
msgid "Started at"
msgstr "Alkoi klo"

msgctxt "game.field.updated_at"
msgid "Updated at"
msgstr "Päivitetty klo"

