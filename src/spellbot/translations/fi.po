msgid "Support SpellBot"
msgstr "Tue SpellBotia"

#, python-format
msgctxt "game.field.support_text"
msgid "Become [a patron](%(subscribe)s) or give a [one-off tip](%(donate)s)."
msgstr "Ryhdy [kuukausitukijaksi](%(subscribe)s) tai anna [kertalahjoitus](%(donate)s)."

#, python-format
msgctxt "game.field.convoke_guild"
msgid "Play more with **%(name)s** on Convoke. [Join the guild!](%(url)s)"
msgstr "Pelaa enemmän killan **%(name)s** kanssa Convokessa. [Liity kiltaan!](%(url)s)"

msgctxt "game.field.settings"
msgid "Settings"
msgstr "Asetukset"

#, python-format
msgctxt "game.field.settings_text"
msgid "See [live games](%(queues)s) and configure [your notifications](%(notify)s)."
msgstr "Katso [live-pelejä](%(queues)s) ja määritä [ilmoituksesi](%(notify)s)."

#, python-format
msgctxt "game.footer"
msgid "SpellBot Game ID: #SB%(game_id)s — Service: %(service)s"
msgstr "SpellBot-pelitunnus: #SB%(game_id)s, palvelu: %(service)s"

msgctxt "service.not_any"
msgid "_Please contact the players in your game to organize this game._"
msgstr "_Ota yhteyttä pelin pelaajiin pelin järjestämiseksi._"

#, python-format
msgctxt "service.spelltable"
msgid "_Please go create a game on %(emoji)s[SpellTable](https://spelltable.wizards.com/) for this game._"
msgstr "_Luo tätä peliä varten peli kohteessa %(emoji)s[SpellTable](https://spelltable.wizards.com/)._"

msgctxt "service.cockatrice"
msgid "_Please use Cockatrice for this game._"
msgstr "_Käytä tätä peliä varten Cockatricea._"

msgctxt "service.xmage"
msgid "_Please use XMage for this game._"
msgstr "_Käytä tätä peliä varten XMagea._"

msgctxt "service.mtg_arena"
msgid "_Please use MTG Arena for this game._"
msgstr "_Käytä tätä peliä varten MTG Arenaa._"

msgctxt "service.mtg_online"
msgid "_Please use MTG Online for this game._"
msgstr "_Käytä tätä peliä varten MTG Onlinea._"

msgctxt "service.tts"
msgid "_Please use TabletopSim for this game._"
msgstr "_Käytä tätä peliä varten TabletopSimiä._"

#, python-format
msgctxt "service.convoke"
msgid "_A %(emoji)s[Convoke](https://www.convoke.games/) link will be created when all players have joined._"
msgstr "_ %(emoji)s[Convoke](https://www.convoke.games/) -linkki luodaan, kun kaikki pelaajat ovat liittyneet._"

#, python-format
msgctxt "service.girudo"
msgid "_A %(emoji)s[Girudo](https://www.girudo.com/) link will be created when all players have joined._"
msgstr "_ %(emoji)s[Girudo](https://www.girudo.com/) -linkki luodaan, kun kaikki pelaajat ovat liittyneet._"

#, python-format
msgctxt "service.edhlab"
msgid "_A %(emoji)s[EDHLAB](https://edhlab.gg/) link will be created when all players have joined._"
msgstr "_ %(emoji)s[EDHLAB](https://edhlab.gg/) -linkki luodaan, kun kaikki pelaajat ovat liittyneet._"

#, python-format
msgctxt "service.playgroup_live"
msgid "*A %(emoji)s[Playgroup Live](https://playgroup.gg/) link will be created when all players have joined.*"
msgstr "*%(emoji)s[Playgroup Live](https://playgroup.gg/) -linkki luodaan, kun kaikki pelaajat ovat liittyneet.*"

msgctxt "lfg.playgroup_link_required"
msgid "To use Playgroup Live, at least one player must link their account. Run `/playgroup link` and try again."
msgstr "Playgroup Liven käyttö edellyttää, että vähintään yksi pelaaja yhdistää tilinsä. Suorita `/playgroup link` ja yritä uudelleen."

msgctxt "lfg.run_in_channel"
msgid "Please run this command in the same channel as your last played game."
msgstr "Suorita tämä komento samalla kanavalla kuin viimeisin pelisi."

msgctxt "lfg.already_pending"
msgid "You're already in a pending game, leave that one first."
msgstr "Olet jo avoimessa pelissä: poistu ensin kyseisestä pelistä."

msgctxt "lfg.no_previous_game"
msgid "You have not played a game in this guild yet."
msgstr "Et ole vielä pelannut yhtään peliä tässä killassa."

msgctxt "lfg.run_in_game_channel"
msgid "Please run this command in the same channel as your game."
msgstr "Suorita tämä komento samalla kanavalla kuin pelisi."

msgctxt "lfg.not_pending_here"
msgid "You're not in a pending game in this channel."
msgstr "Et ole avoimessa pelissä tällä kanavalla."

msgctxt "lfg.start_needs_players"
msgid "You need at least one other player before you can start a game."
msgstr "Tarvitset vähintään yhden muun pelaajan, ennen kuin voit aloittaa pelin."

msgctxt "lfg.unsupported_context"
msgid "Sorry, that command is not supported in this context."
msgstr "Tätä komentoa ei valitettavasti tueta tässä yhteydessä."

msgctxt "lfg.already_in_channel"
msgid "You're already in a game in this channel."
msgstr "Olet jo pelissä tällä kanavalla."

msgctxt "lfg.too_many_pending"
msgid "You're in too many pending games to join another one at this time."
msgstr "Sinulla on liian monta avointa peliä, etkä voi liittyä uuteen peliin juuri nyt."

msgctxt "lfg.too_many_friends"
msgid "You mentioned too many players."
msgstr "Mainitsit liian monta pelaajaa."

msgctxt "lfg.guild_war_invalid"
msgid "That Guild War is not available. Use autocomplete to pick a live war."
msgstr "Tuo kiltasota ei ole saatavilla. Käytä automaattista täydennystä valitaksesi aktiivisen sodan."

#, python-format
msgctxt "lfg.guild_war_seats"
msgid "Guild War matches need between %(min)s and %(max)s seats."
msgstr "Kiltasotaottelut tarvitsevat %(min)s–%(max)s paikkaa."

msgctxt "lfg.cannot_join"
msgid "You can not join this game."
msgstr "Et voi liittyä tähän peliin."

msgctxt "lfg.game_started"
msgid "Sorry, that game has already started."
msgstr "Pahoittelut, tämä peli on jo alkanut."

msgctxt "lfg.game_full"
msgid "Sorry, that game is already full."
msgstr "Pahoittelut, tämä peli on jo täynnä."

#, python-format
msgctxt "lfg.invalid_player_count"
msgid "You can't create a %(format)s game with %(count)s players."
msgstr "Et voi luoda %(format)s -peliä %(count)s pelaajalla."

#, python-format
msgctxt "lfg.excluded_players"
msgid "Some of the players you mentioned can not be added to a game: %(players)s"
msgstr "Joitakin mainitsemiasi pelaajia ei voida lisätä peliin: %(players)s"

#, python-format
msgctxt "lfg.found_game"
msgid "I found a %(format)s game for you!"
msgstr "Löysin sinulle %(format)s -pelin!"

#, python-format
msgctxt "lfg.jump_to_game"
msgid "You can [jump to the game post](%(link)s) to see it!"
msgstr "Näet sen [siirtymällä pelijulkaisuun](%(link)s)!"

