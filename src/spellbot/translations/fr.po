msgstr[1] "**En attente de %(count)s autres joueurs…**"

msgctxt "game.description.check_dm"
msgid "Please check your Direct Messages for your game details."
msgstr "Veuillez vérifier vos messages directs pour y trouver les détails de votre partie."

msgctxt "game.description.rematch_info"
msgid "This is a rematch of a previous game. Please continue using the same game lobby and voice channel."
msgstr "Ceci est la revanche d'une précédente partie. Veuillez utiliser les mêmes lobby de jeu et canal vocal."

