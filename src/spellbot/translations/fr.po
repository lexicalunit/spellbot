msgctxt "game.title.ready"
msgid "**Your game is ready!**"
msgstr "**Votre jeu est prêt !**"

msgctxt "game.title.rematch"
msgid "**Rematch Game!**"
msgstr "**Partie revanche !**"

#, python-format
msgctxt "game.title.waiting"
msgid "**Waiting for %(count)s more player to join...**"
msgid_plural "**Waiting for %(count)s more players to join...**"
