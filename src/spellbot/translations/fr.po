msgid "the game's SpellBot ID"
msgstr "l'ID SpellBot de la partie"

msgctxt "web.motd.game_format"
msgid "the game's format (e.g. Commander)"
msgstr "le format de la partie (p. ex. Commander)"

msgctxt "web.motd.game_bracket"
