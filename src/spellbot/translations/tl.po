msgid "Please run this command in the same channel as your game."
msgstr "Paki-run ang command na ito sa channel na ginagamit mo sa iyong game."

msgctxt "lfg.not_pending_here"
msgid "You're not in a pending game in this channel."
msgstr "Wala ka sa isang pending game sa channel na ito."

msgctxt "lfg.start_needs_players"
msgid "You need at least one other player before you can start a game."
msgstr "Kailangan mo ng hindi bababa sa isa pang manlalaro bago ka makapagsimula ng laro."

msgctxt "lfg.unsupported_context"
msgid "Sorry, that command is not supported in this context."
msgstr "Pasensya na, hindi sinusuportahan ang command sa kontekstong ito."

msgctxt "lfg.already_in_channel"
msgid "You're already in a game in this channel."
msgstr "Nasa isang game ka na sa channel na ito."

msgctxt "lfg.too_many_pending"
msgid "You're in too many pending games to join another one at this time."
msgstr "Masyado ka nang maraming sinalihang pending game para sumali ng isa pa sa ngayon."

msgctxt "lfg.too_many_friends"
msgid "You mentioned too many players."
msgstr "Masyado kang maraming na-mention na player."

msgctxt "lfg.guild_war_invalid"
msgid "That Guild War is not available. Use autocomplete to pick a live war."
msgstr "Hindi available ang digmaang iyon ng guild. Gamitin ang autocomplete para pumili ng aktibong digmaan."

