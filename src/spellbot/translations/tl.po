msgstr "_Gagawa ng %(emoji)s[Convoke](https://www.convoke.games/) na link kapag nakasali na ang lahat ng player._"

#, python-format
msgctxt "service.girudo"
msgid "_A %(emoji)s[Girudo](https://www.girudo.com/) link will be created when all players have joined._"
msgstr "_Gagawa ng %(emoji)s[Girudo](https://www.girudo.com/) na link kapag nakasali na ang lahat ng player._"

#, python-format
msgctxt "service.edhlab"
msgid "_A %(emoji)s[EDHLAB](https://edhlab.gg/) link will be created when all players have joined._"
msgstr "_Gagawa ng %(emoji)s[EDHLAB](https://edhlab.gg/) na link kapag nakasali na ang lahat ng player._"

#, python-format
msgctxt "service.playgroup_live"
