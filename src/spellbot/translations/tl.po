msgstr "_Gagawa ng %(emoji)s[Playgroup Live](https://playgroup.gg/) na link kapag nakasali na ang lahat ng player._"

msgctxt "lfg.playgroup_link_required"
msgid "To use Playgroup Live, at least one player must link their account. Run `/playgroup link` and try again."
msgstr "Para magamit ang Playgroup Live, kailangang may kahit isang player lang na mag-link ng kanyang account. I-run ang `/playgroup link` at subukan ulit."

msgctxt "lfg.run_in_channel"
msgid "Please run this command in the same channel as your last played game."
msgstr "Paki-run ang command na ito sa channel na ginamit sa huli mong nilarong game."

msgctxt "lfg.already_pending"
msgid "You're already in a pending game, leave that one first."
msgstr "Nasa isang pending game ka na, umalis muna roon."

