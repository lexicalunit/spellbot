msgctxt "game.description.jump_to_post"
msgid "You can also [jump to the original game post](%(link)s) in <#%(channel_id)s>."
msgstr "Puwede ka ring [pumunta sa orihinal na game post](%(link)s) sa <#%(channel_id)s>."

msgctxt "game.war_convoke_only"
msgid "This Guild War table no longer takes players through SpellBot, but you can still join it on Convoke."
msgstr "Hindi na tumatanggap ng mga manlalaro sa SpellBot ang table ng Digmaan ng Guild na ito, pero puwede ka pa ring sumali sa Convoke."

