msgstr "_Kontakin ang mga player sa game mo para i-organize ang game na ito._"

#, python-format
msgctxt "service.spelltable"
msgid "_Please go create a game on %(emoji)s[SpellTable](https://spelltable.wizards.com/) for this game._"
msgstr "_Pumunta at gumawa ng game sa %(emoji)s[SpellTable](https://spelltable.wizards.com/) para sa game na ito._"

msgctxt "service.cockatrice"
msgid "_Please use Cockatrice for this game._"
msgstr "_Pakigamit ang Cockatrice para sa game na ito._"

msgctxt "service.xmage"
msgid "_Please use XMage for this game._"
msgstr "_Pakigamit ang XMage para sa game na ito._"

msgctxt "service.mtg_arena"
