#, python-format
msgctxt "admin.expire_deleting"
msgid "├── Deleting message %(message_id)s ..."
msgstr "├── Διαγραφή μηνύματος %(message_id)s ..."

#, python-format
msgctxt "admin.expire_updating"
msgid "├── Updating message %(message_id)s ..."
msgstr "├── Ενημέρωση μηνύματος %(message_id)s ..."

msgctxt "admin.expire_no_permission"
