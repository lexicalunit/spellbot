msgctxt "game.title.ready"
msgid "**Your game is ready!**"
msgstr "**Το παιχνίδι σας είναι έτοιμο!**"

msgctxt "game.title.rematch"
msgid "**Rematch Game!**"
msgstr "**Παιχνίδι ρεβάνς!**"

#, python-format
msgctxt "game.title.waiting"
msgid "**Waiting for %(count)s more player to join...**"
msgid_plural "**Waiting for %(count)s more players to join...**"
msgstr[0] "**Αναμονή για να συμμετάσχει %(count)s ακόμη παίκτης...**"
msgstr[1] "**Αναμονή για να συμμετάσχουν %(count)s ακόμη παίκτες...**"

msgctxt "game.description.check_dm"
msgid "Please check your Direct Messages for your game details."
msgstr "Ελέγξτε τα άμεσα μηνύματά σας για να δείτε τα στοιχεία του παιχνιδιού σας."

msgctxt "game.description.rematch_info"
msgid "This is a rematch of a previous game. Please continue using the same game lobby and voice channel."
msgstr "Αυτή είναι ρεβάνς ενός προηγούμενου παιχνιδιού. Συνεχίστε να χρησιμοποιείτε το ίδιο λόμπι παιχνιδιού και το ίδιο φωνητικό κανάλι."

#, python-format
msgctxt "game.description.join_link"
msgid "# [Join your %(service)s game now!](%(link)s)"
msgstr "# [Συμμετέχετε στο παιχνίδι σας %(service)s τώρα!](%(link)s)"

#, python-format
msgctxt "game.description.link_error"
msgid "Sorry but SpellBot was unable to create a link for this game. Please go to [%(service)s](%(url)s) to create one."
msgstr "Λυπούμαστε αλλά το SpellBot δεν κατάφερε να δημιουργήσει σύνδεσμο για αυτό το παιχνίδι. Μεταβείτε στο [%(service)s](%(url)s) για να δημιουργήσετε έναν."

#, python-format
msgctxt "game.description.use_service"
msgid "Please use %(service)s to play this game."
msgstr "Χρησιμοποιήστε %(service)s για να παίξετε αυτό το παιχνίδι."

msgctxt "game.description.contact_players"
msgid "Contact the other players in your game to organize this match."
msgstr "Επικοινωνήστε με τους άλλους παίκτες στο παιχνίδι σας για να οργανώσετε αυτόν τον αγώνα."

#, python-format
msgctxt "game.description.password"
msgid "Password: `%(password)s`"
msgstr "Κωδικός πρόσβασης: `%(password)s`"

#, python-format
msgctxt "game.description.voice_chat"
msgid "## Join your voice chat now: <#%(channel_id)s>"
msgstr "## Συμμετέχετε στη φωνητική συνομιλία τώρα: <#%(channel_id)s>"

#, python-format
msgctxt "game.description.voice_invite"
msgid "Or use this voice channel invite: %(invite)s"
msgstr "Ή χρησιμοποιήστε αυτήν την πρόσκληση φωνητικού καναλιού: %(invite)s"

#, python-format
msgctxt "game.description.voice_already_picked"
msgid "## Your pod is already using a voice channel, join them now: <#%(channel_id)s>!"
msgstr "## Η ομάδα σας χρησιμοποιεί ήδη φωνητικό κανάλι. Συμμετέχετε τώρα: <#%(channel_id)s>!"

#, python-format
msgctxt "game.description.voice_available"
msgid "## Please consider using this available voice channel: <#%(channel_id)s>."
msgstr "## Σκεφτείτε να χρησιμοποιήσετε αυτό το διαθέσιμο φωνητικό κανάλι: <#%(channel_id)s>."

#, python-format
msgctxt "game.description.jump_to_post"
msgid "You can also [jump to the original game post](%(link)s) in <#%(channel_id)s>."
msgstr "Μπορείτε επίσης να [μεταβείτε στην αρχική ανάρτηση του παιχνιδιού](%(link)s) στο <#%(channel_id)s>."

msgctxt "game.war_convoke_only"
msgid "This Guild War table no longer takes players through SpellBot, but you can still join it on Convoke."
msgstr "Αυτό το τραπέζι του Πολέμου συντεχνιών δεν δέχεται πλέον παίκτες μέσω του SpellBot, αλλά μπορείτε ακόμα να συμμετάσχετε στο Convoke."

msgctxt "game.field.rules"
msgid "⚠️ Additional Rules:"
msgstr "⚠️ Πρόσθετοι κανόνες:"

msgctxt "game.field.guild_war"
msgid "⚔️ Guild War"
msgstr "⚔️ Πόλεμος συντεχνιών"

msgctxt "game.field.players"
msgid "Players"
msgstr "Παίκτες"

#, python-format
msgctxt "game.field.players_hidden"
msgid "**%(count)s player name is hidden**"
msgid_plural "**%(count)s player names are hidden**"
msgstr[0] "**%(count)s όνομα παίκτη είναι κρυμμένο**"
msgstr[1] "**%(count)s ονόματα παίκτη είναι κρυμμένα**"

msgctxt "game.field.format"
msgid "Format"
msgstr "Φόρματ"

msgctxt "game.field.bracket"
msgid "Bracket"
msgstr "Επίπεδο"

msgctxt "game.field.started_at"
msgid "Started at"
msgstr "Ξεκίνησε στις"

msgctxt "game.field.updated_at"
msgid "Updated at"
msgstr "Ενημερώθηκε στις"

msgctxt "game.field.voice_channel"
msgid "🔊 Suggested Voice Channel"
msgstr "🔊 Προτεινόμενο φωνητικό κανάλι"

msgctxt "game.field.support"
msgid "Support SpellBot"
msgstr "Υποστήριξη SpellBot"

#, python-format
msgctxt "game.field.support_text"
msgid "Become [a patron](%(subscribe)s) or give a [one-off tip](%(donate)s)."
msgstr "Γίνετε [προστάτης](%(subscribe)s) ή δώστε μια [εφάπαξ συμβουλή](%(donate)s)."

#, python-format
msgctxt "game.field.convoke_guild"
msgid "Play more with **%(name)s** on Convoke. [Join the guild!](%(url)s)"
msgstr "Παίξε περισσότερο με το **%(name)s** στο Convoke. [Γίνε μέλος του guild!](%(url)s)"

msgctxt "game.field.settings"
msgid "Settings"
msgstr "Ρυθμίσεις"

#, python-format
msgctxt "game.field.settings_text"
msgid "See [live games](%(queues)s) and configure [your notifications](%(notify)s)."
msgstr "Δες [ζωντανά παιχνίδια](%(queues)s) και ρύθμισε [τις ειδοποιήσεις σου](%(notify)s)."

#, python-format
msgctxt "game.footer"
msgid "SpellBot Game ID: #SB%(game_id)s — Service: %(service)s"
msgstr "ID παιχνιδιού SpellBot: #SB%(game_id)s — Υπηρεσία: %(service)s"

msgctxt "service.not_any"
msgid "_Please contact the players in your game to organize this game._"
msgstr "_Επικοινωνήστε με τους παίκτες στο παιχνίδι σας για να οργανώσετε αυτό το παιχνίδι._"

#, python-format
msgctxt "service.spelltable"
msgid "_Please go create a game on %(emoji)s[SpellTable](https://spelltable.wizards.com/) for this game._"
msgstr "_Δημιουργήστε ένα παιχνίδι στο %(emoji)s[SpellTable](https://spelltable.wizards.com/) για αυτό το παιχνίδι._"

msgctxt "service.cockatrice"
msgid "_Please use Cockatrice for this game._"
msgstr "_Χρησιμοποιήστε το Cockatrice για αυτό το παιχνίδι._"

msgctxt "service.xmage"
msgid "_Please use XMage for this game._"
msgstr "_Χρησιμοποιήστε το XMage για αυτό το παιχνίδι._"

msgctxt "service.mtg_arena"
msgid "_Please use MTG Arena for this game._"
msgstr "_Χρησιμοποιήστε το MTG Arena για αυτό το παιχνίδι._"

msgctxt "service.mtg_online"
msgid "_Please use MTG Online for this game._"
msgstr "_Χρησιμοποιήστε το MTG Online για αυτό το παιχνίδι._"

msgctxt "service.tts"
msgid "_Please use TabletopSim for this game._"
msgstr "_Χρησιμοποιήστε το TabletopSim για αυτό το παιχνίδι._"

#, python-format
msgctxt "service.convoke"
msgid "_A %(emoji)s[Convoke](https://www.convoke.games/) link will be created when all players have joined._"
msgstr "_Ένας σύνδεσμος %(emoji)s[Convoke](https://www.convoke.games/) θα δημιουργηθεί όταν έχουν μπει όλοι οι παίκτες._"

#, python-format
msgctxt "service.girudo"
msgid "_A %(emoji)s[Girudo](https://www.girudo.com/) link will be created when all players have joined._"
msgstr "_Ένας σύνδεσμος %(emoji)s[Girudo](https://www.girudo.com/) θα δημιουργηθεί όταν έχουν μπει όλοι οι παίκτες._"

#, python-format
msgctxt "service.edhlab"
msgid "_A %(emoji)s[EDHLAB](https://edhlab.gg/) link will be created when all players have joined._"
msgstr "_Ένας σύνδεσμος %(emoji)s[EDHLAB](https://edhlab.gg/) θα δημιουργηθεί όταν έχουν μπει όλοι οι παίκτες._"

#, python-format
msgctxt "service.playgroup_live"
msgid "*A %(emoji)s[Playgroup Live](https://playgroup.gg/) link will be created when all players have joined.*"
msgstr "*Ένας σύνδεσμος %(emoji)s[Playgroup Live](https://playgroup.gg/) θα δημιουργηθεί όταν έχουν μπει όλοι οι παίκτες.*"

msgctxt "lfg.playgroup_link_required"
msgid "To use Playgroup Live, at least one player must link their account. Run `/playgroup link` and try again."
msgstr "Για να χρησιμοποιήσετε το Playgroup Live, τουλάχιστον ένας παίκτης πρέπει να συνδέσει τον λογαριασμό του. Εκτελέστε την εντολή `/playgroup link` και προσπαθήστε ξανά."

msgctxt "lfg.run_in_channel"
msgid "Please run this command in the same channel as your last played game."
msgstr "Εκτελέστε αυτή την εντολή στο ίδιο κανάλι με το τελευταίο παιχνίδι που παίξατε."

msgctxt "lfg.already_pending"
msgid "You're already in a pending game, leave that one first."
msgstr "Είστε ήδη σε ένα παιχνίδι σε εκκρεμότητα, αποχωρήστε πρώτα από αυτό."

msgctxt "lfg.no_previous_game"
msgid "You have not played a game in this guild yet."
msgstr "Δεν έχετε παίξει ακόμα παιχνίδι σε αυτή την ομάδα."

msgctxt "lfg.run_in_game_channel"
msgid "Please run this command in the same channel as your game."
msgstr "Εκτελέστε αυτή την εντολή στο ίδιο κανάλι με το παιχνίδι σας."

msgctxt "lfg.not_pending_here"
msgid "You're not in a pending game in this channel."
msgstr "Δεν βρίσκεστε σε παιχνίδι που είναι σε εκκρεμότητα σε αυτό το κανάλι."

msgctxt "lfg.start_needs_players"
msgid "You need at least one other player before you can start a game."
msgstr "Χρειάζεστε τουλάχιστον έναν ακόμη παίκτη πριν μπορέσετε να ξεκινήσετε ένα παιχνίδι."

msgctxt "lfg.unsupported_context"
msgid "Sorry, that command is not supported in this context."
msgstr "Λυπούμαστε, αυτή η εντολή δεν υποστηρίζεται σε αυτό το πλαίσιο."

msgctxt "lfg.already_in_channel"
msgid "You're already in a game in this channel."
msgstr "Είστε ήδη σε ένα παιχνίδι σε αυτό το κανάλι."

msgctxt "lfg.too_many_pending"
msgid "You're in too many pending games to join another one at this time."
msgstr "Είστε σε πάρα πολλά παιχνίδια που είναι σε εκκρεμότητα για να συμμετάσχετε σε ένα άλλο αυτή τη στιγμή."

msgctxt "lfg.too_many_friends"
msgid "You mentioned too many players."
msgstr "Αναφέρατε πάρα πολλούς παίκτες."

msgctxt "lfg.guild_war_invalid"
msgid "That Guild War is not available. Use autocomplete to pick a live war."
msgstr "Αυτός ο πόλεμος συντεχνιών δεν είναι διαθέσιμος. Χρησιμοποιήστε την αυτόματη συμπλήρωση για να επιλέξετε έναν ενεργό πόλεμο."

#, python-format
msgctxt "lfg.guild_war_seats"
msgid "Guild War matches need between %(min)s and %(max)s seats."
msgstr "Οι αγώνες πολέμου συντεχνιών χρειάζονται από %(min)s έως %(max)s θέσεις."

msgctxt "lfg.cannot_join"
msgid "You can not join this game."
msgstr "Δεν μπορείτε να συμμετάσχετε σε αυτό το παιχνίδι."

msgctxt "lfg.game_started"
msgid "Sorry, that game has already started."
msgstr "Λυπούμαστε, το παιχνίδι έχει ήδη ξεκινήσει."

msgctxt "lfg.game_full"
msgid "Sorry, that game is already full."
msgstr "Λυπούμαστε, το παιχνίδι είναι ήδη πλήρες."

#, python-format
msgctxt "lfg.invalid_player_count"
msgid "You can't create a %(format)s game with %(count)s players."
msgstr "Δεν μπορείτε να δημιουργήσετε παιχνίδι %(format)s με %(count)s παίκτες."

#, python-format
msgctxt "lfg.excluded_players"
msgid "Some of the players you mentioned can not be added to a game: %(players)s"
msgstr "Μερικοί από τους παίκτες που αναφέρατε δεν μπορούν να προστεθούν σε ένα παιχνίδι: %(players)s"

#, python-format
msgctxt "lfg.found_game"
msgid "I found a %(format)s game for you!"
msgstr "Βρήκα ένα παιχνίδι %(format)s για εσάς!"

#, python-format
msgctxt "lfg.jump_to_game"
msgid "You can [jump to the game post](%(link)s) to see it!"
msgstr "Μπορείτε [να μεταβείτε στην ανάρτηση του παιχνιδιού](%(link)s) για να το δείτε!"

#, python-format
msgctxt "lfg.joined_game"
msgid "You have joined the game SB%(game_id)s!"
msgstr "Έχετε μπει στο παιχνίδι SB%(game_id)s!"

#, python-format
msgctxt "lfg.started_game"
msgid "I started your %(format)s game for you!"
msgstr "Ξεκίνησα το παιχνίδι %(format)s για εσάς!"

#, python-format
msgctxt "lfg.game_started_id"
msgid "The game SB%(game_id)s has been started!"
msgstr "Το παιχνίδι SB%(game_id)s έχει ξεκινήσει!"

#, python-format
msgctxt "lfg.dm_failures"
msgid "Unable to send Direct Messages to some players: %(players)s"
msgstr "Δεν είναι δυνατή η αποστολή άμεσων μηνυμάτων σε ορισμένους παίκτες: %(players)s"

#, python-format
msgctxt "lfg.award_failure_give"
msgid "Unable to give role %(role)s to user <@%(user_id)s>"
msgstr "Δεν είναι δυνατή η εκχώρηση του ρόλου %(role)s στον χρήστη <@%(user_id)s>"

#, python-format
msgctxt "lfg.award_failure_take"
msgid "Unable to take role %(role)s from user <@%(user_id)s>"
msgstr "Δεν είναι δυνατή η ανάληψη του ρόλου %(role)s από τον χρήστη <@%(user_id)s>"

#, python-format
msgctxt "lfg.mythic_track"
msgid "Track your game on %(emoji)s[Mythic Track](%(link)s) with PIN code: `%(pin)s`"
msgstr "Παρακολουθήστε το παιχνίδι σας στο %(emoji)s[Mythic Track](%(link)s) με τον κωδικό PIN: `%(pin)s`"

msgctxt "button.join"
msgid "Join this game!"
msgstr "Συμμετοχή σε αυτό το παιχνίδι!"

msgctxt "button.leave"
msgid "Leave"
msgstr "Αποχώρηση"

msgctxt "admin.no_game_found"
msgid "There is no game with that ID."
msgstr "Δεν υπάρχει παιχνίδι με αυτό το ID."

msgctxt "admin.done"
msgid "Done."
msgstr "Τελείωσε."

#, python-format
msgctxt "admin.channels_title"
msgid "Configuration for channels in %(guild)s"
msgstr "Διαμόρφωση καναλιών στο %(guild)s"

#, python-format
msgctxt "admin.setup_title"
msgid "SpellBot Setup for %(guild)s"
msgstr "Ρύθμιση SpellBot για το %(guild)s"

#, python-format
msgctxt "admin.setup_description"
msgid ""
"SpellBot helps your community find and play Magic: The Gathering games together. To configure your server, channels, and player awards, visit the SpellBot dashboard.\n"
"\n"
"[Configure SpellBot →](%(link)s)"
msgstr ""
"Το SpellBot βοηθά την κοινότητά σας να βρει και να παίξει παιχνίδια Magic: The Gathering μαζί. Για να διαμορφώσετε τον διακομιστή, τα κανάλια και τα βραβεία παικτών σας, επισκεφθείτε τον πίνακα ελέγχου του SpellBot.\n"
"\n"
"[Διαμόρφωση SpellBot →](%(link)s)"

#, python-format
msgctxt "admin.user_move_error"
msgid "Error: %(error)s"
msgstr "Σφάλμα: %(error)s"

#, python-format
msgctxt "admin.user_moved"
msgid "User %(from_user)s has been moved to %(to_user)s"
msgstr "Ο χρήστης %(from_user)s μεταφέρθηκε στο %(to_user)s"

#, python-format
msgctxt "admin.expire_dequeued"
