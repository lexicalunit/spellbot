msgctxt "game.title.ready"
msgid "**Your game is ready!**"
msgstr "**Twój mecz jest gotowy!**"

msgctxt "game.title.rematch"
msgid "**Rematch Game!**"
msgstr "**Mecz rewanżowy!**"

#, python-format
msgctxt "game.title.waiting"
msgid "**Waiting for %(count)s more player to join...**"
msgid_plural "**Waiting for %(count)s more players to join...**"
msgstr[0] "**Oczekiwanie na dołączenie jeszcze %(count)s gracza...**"
msgstr[1] "**Oczekiwanie na dołączenie jeszcze %(count)s graczy...**"
msgstr[2] "**Oczekiwanie na dołączenie jeszcze %(count)s graczy...**"

msgctxt "game.description.check_dm"
msgid "Please check your Direct Messages for your game details."
msgstr "Sprawdź szczegóły meczu w swoich wiadomościach bezpośrednich."

msgctxt "game.description.rematch_info"
msgid "This is a rematch of a previous game. Please continue using the same game lobby and voice channel."
msgstr "To jest rewanż za poprzedni mecz. Pozostań w tym samym lobby meczu i na tym samym kanale głosowym."

#, python-format
msgctxt "game.description.join_link"
msgid "# [Join your %(service)s game now!](%(link)s)"
msgstr "# [Dołącz do swojego meczu %(service)s teraz!](%(link)s)"

#, python-format
msgctxt "game.description.link_error"
msgid "Sorry but SpellBot was unable to create a link for this game. Please go to [%(service)s](%(url)s) to create one."
msgstr "Przepraszamy, SpellBot nie był w stanie utworzyć linku do tego meczu. Przejdź do [%(service)s](%(url)s), aby go utworzyć."

#, python-format
msgctxt "game.description.use_service"
msgid "Please use %(service)s to play this game."
msgstr "Użyj %(service)s, aby rozegrać ten mecz."

msgctxt "game.description.contact_players"
msgid "Contact the other players in your game to organize this match."
msgstr "Skontaktuj się z innymi graczami w grze, aby zorganizować ten mecz."

#, python-format
msgctxt "game.description.password"
msgid "Password: `%(password)s`"
msgstr "Hasło: `%(password)s`"

#, python-format
msgctxt "game.description.voice_chat"
msgid "## Join your voice chat now: <#%(channel_id)s>"
msgstr "## Dołącz do czatu głosowego teraz: <#%(channel_id)s>"

#, python-format
msgctxt "game.description.voice_invite"
msgid "Or use this voice channel invite: %(invite)s"
msgstr "Możesz też użyć tego zaproszenia do kanału głosowego: %(invite)s"

#, python-format
msgctxt "game.description.voice_already_picked"
msgid "## Your pod is already using a voice channel, join them now: <#%(channel_id)s>!"
msgstr "## Twoja podgrupa już używa kanału głosowego, dołącz do niego teraz: <#%(channel_id)s>!"

#, python-format
msgctxt "game.description.voice_available"
msgid "## Please consider using this available voice channel: <#%(channel_id)s>."
msgstr "## Rozważ użycie tego dostępnego kanału głosowego: <#%(channel_id)s>."

#, python-format
msgctxt "game.description.jump_to_post"
msgid "You can also [jump to the original game post](%(link)s) in <#%(channel_id)s>."
msgstr "Możesz również [przejść do oryginalnego posta](%(link)s) w kanale <#%(channel_id)s>."

msgctxt "game.war_convoke_only"
msgid "This Guild War table no longer takes players through SpellBot, but you can still join it on Convoke."
msgstr "Ten stół wojny gildii nie przyjmuje już graczy przez SpellBot, ale nadal możesz do niego dołączyć na Convoke."

