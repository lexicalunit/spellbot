msgctxt "game.field.settings_text"
msgid "See [live games](%(queues)s) and configure [your notifications](%(notify)s)."
msgstr "Zobacz [gry na żywo](%(queues)s) i skonfiguruj [swoje powiadomienia](%(notify)s)."

#, python-format
msgctxt "game.footer"
msgid "SpellBot Game ID: #SB%(game_id)s — Service: %(service)s"
msgstr "Identyfikator meczu SpellBota: #SB%(game_id)s — usługa: %(service)s"

msgctxt "service.not_any"
msgid "_Please contact the players in your game to organize this game._"
msgstr "_Skontaktuj się z graczami w grze, aby zorganizować ten mecz._"

#, python-format
msgctxt "service.spelltable"
msgid "_Please go create a game on %(emoji)s[SpellTable](https://spelltable.wizards.com/) for this game._"
msgstr "_Utwórz mecz w %(emoji)s[SpellTable](https://spelltable.wizards.com/) tej gry._"

msgctxt "service.cockatrice"
msgid "_Please use Cockatrice for this game._"
msgstr "_Użyj Cockatrice do tego meczu._"

msgctxt "service.xmage"
msgid "_Please use XMage for this game._"
msgstr "_Użyj XMage do tego meczu._"

msgctxt "service.mtg_arena"
msgid "_Please use MTG Arena for this game._"
msgstr "_Użyj MtG Arena do tego meczu._"

msgctxt "service.mtg_online"
msgid "_Please use MTG Online for this game._"
msgstr "_Użyj MTG Online do tego meczu._"

msgctxt "service.tts"
msgid "_Please use TabletopSim for this game._"
msgstr "_Użyj TabletopSim do tego meczu._"

#, python-format
msgctxt "service.convoke"
msgid "_A %(emoji)s[Convoke](https://www.convoke.games/) link will be created when all players have joined._"
msgstr "_Link %(emoji)s[Convoke](https://www.convoke.games/) zostanie utworzony, gdy dołączą wszyscy gracze._"

#, python-format
msgctxt "service.girudo"
msgid "_A %(emoji)s[Girudo](https://www.girudo.com/) link will be created when all players have joined._"
msgstr "_Link %(emoji)s[Girudo](https://www.girudo.com/) zostanie utworzony, gdy dołączą wszyscy gracze._"

#, python-format
msgctxt "service.edhlab"
msgid "_A %(emoji)s[EDHLAB](https://edhlab.gg/) link will be created when all players have joined._"
msgstr "_Link %(emoji)s[EDHLAB](https://edhlab.gg/) zostanie utworzony, gdy dołączą wszyscy gracze._"

#, python-format
msgctxt "service.playgroup_live"
msgid "*A %(emoji)s[Playgroup Live](https://playgroup.gg/) link will be created when all players have joined.*"
msgstr "*Link %(emoji)s[Playgroup Live](https://playgroup.gg/) zostanie utworzony, gdy dołączą wszyscy gracze.*"

msgctxt "lfg.playgroup_link_required"
msgid "To use Playgroup Live, at least one player must link their account. Run `/playgroup link` and try again."
msgstr "Aby można było użyć Playgroup Live, co najmniej jeden gracz musi powiązać swoje konto. Uruchom `/playgroup link` i spróbuj ponownie."

msgctxt "lfg.run_in_channel"
msgid "Please run this command in the same channel as your last played game."
msgstr "Uruchom tę komendę na kanale ostatniego meczu."

msgctxt "lfg.already_pending"
msgid "You're already in a pending game, leave that one first."
msgstr "Jesteś już w oczekującym meczu, najpierw go opuść."

msgctxt "lfg.no_previous_game"
msgid "You have not played a game in this guild yet."
msgstr "Jeszcze nie grałeś(-aś) w tej gildii."

msgctxt "lfg.run_in_game_channel"
msgid "Please run this command in the same channel as your game."
msgstr "Uruchom tę komendę na kanale meczu."

msgctxt "lfg.not_pending_here"
msgid "You're not in a pending game in this channel."
msgstr "Nie jesteś w oczekującym meczu na tym kanale."

msgctxt "lfg.start_needs_players"
msgid "You need at least one other player before you can start a game."
msgstr "Potrzebujesz co najmniej jednego innego gracza, zanim rozpoczniesz mecz."

msgctxt "lfg.unsupported_context"
msgid "Sorry, that command is not supported in this context."
msgstr "Przepraszamy, ta komenda nie jest obsługiwana w tym kontekście."

msgctxt "lfg.already_in_channel"
msgid "You're already in a game in this channel."
msgstr "Jesteś już w meczu na tym kanale."

msgctxt "lfg.too_many_pending"
msgid "You're in too many pending games to join another one at this time."
msgstr "Jesteś w zbyt wielu oczekujących meczach, aby dołączyć teraz do kolejnego."

msgctxt "lfg.too_many_friends"
msgid "You mentioned too many players."
msgstr "Wspomniałeś(-aś) o zbyt wielu graczach."

msgctxt "lfg.guild_war_invalid"
msgid "That Guild War is not available. Use autocomplete to pick a live war."
msgstr "Ta wojna gildii jest niedostępna. Użyj autouzupełniania, aby wybrać aktywną wojnę."

#, python-format
msgctxt "lfg.guild_war_seats"
msgid "Guild War matches need between %(min)s and %(max)s seats."
msgstr "Mecze wojny gildii wymagają od %(min)s do %(max)s miejsc."

msgctxt "lfg.cannot_join"
msgid "You can not join this game."
msgstr "Nie możesz dołączyć do tego meczu."

msgctxt "lfg.game_started"
msgid "Sorry, that game has already started."
msgstr "Niestety ten mecz już się rozpoczął."

msgctxt "lfg.game_full"
msgid "Sorry, that game is already full."
msgstr "Niestety ten mecz jest już pełny."

#, python-format
msgctxt "lfg.invalid_player_count"
msgid "You can't create a %(format)s game with %(count)s players."
msgstr "Nie możesz utworzyć meczu %(format)s z %(count)s graczami."

