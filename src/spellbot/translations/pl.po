#, python-format
msgctxt "web.notify.title"
msgid "Notification Preferences — %(name)s"
msgstr "Preferencje powiadomień — %(name)s"

msgctxt "web.notify.meta_description"
msgid "Choose which SpellBot game posts you want to be notified about."
msgstr "Wybierz, o których postach gier SpellBot chcesz otrzymywać powiadomienia."

msgctxt "web.notify.heading"
msgid "Notification Preferences"
msgstr "Preferencje powiadomień"

msgctxt "web.notify.guild_sub"
msgid "Choose what kinds of new games you want to be pinged about in this server."
msgstr "Wybierz, o jakich rodzajach nowych gier chcesz być powiadamiany na tym serwerze."

msgctxt "web.notify.off_label"
msgid "Do not notify me about games on this server"
msgstr "Nie powiadamiaj mnie o grach na tym serwerze"

msgctxt "web.notify.formats"
msgid "Formats"
msgstr "Formaty"

msgctxt "web.notify.formats_hint"
msgid "Select the formats you want to be notified about. Leave empty to receive all formats."
msgstr "Wybierz formaty, o których chcesz być powiadamiany. Pozostaw puste, aby otrzymywać wszystkie formaty."

msgctxt "web.notify.brackets"
msgid "Brackets"
msgstr "Poziomy"

msgctxt "web.notify.brackets_hint"
msgid "Select the brackets you want to be notified about. Leave empty to receive all brackets."
msgstr "Wybierz poziomy, o których chcesz być powiadamiany. Pozostaw puste, aby otrzymywać wszystkie poziomy."

msgctxt "web.notify.channels"
msgid "Channels"
msgstr "Kanały"

msgctxt "web.notify.channels_hint"
msgid "Select the channels you want to be notified about. Leave empty to receive all channels."
msgstr "Wybierz kanały, o których chcesz być powiadamiany. Pozostaw puste, aby otrzymywać wszystkie kanały."

msgctxt "web.notify.active_hours"
msgid "Active Hours"
msgstr "Aktywne godziny"

#, python-format
msgctxt "web.notify.active_hours_hint"
msgid "Only notify me during a specific window of the day, in my local time. Maximum window is %(hours)s hours. Defaults to 5pm–10pm if you don't pick a range."
msgstr "Powiadamiaj mnie tylko w określonym przedziale dnia, w moim czasie lokalnym. Maksymalny przedział to %(hours)s godzin. Domyślnie 17–22, jeśli nie wybierzesz zakresu."

msgctxt "web.notify.limit_window"
msgid "Limit notifications to a daily window"
msgstr "Ogranicz powiadomienia do dziennego przedziału"

msgctxt "web.notify.save"
msgid "Save preferences"
msgstr "Zapisz preferencje"

msgctxt "web.notify.js_saved"
msgid "Your notification preferences have been saved."
msgstr "Twoje preferencje powiadomień zostały zapisane."

msgctxt "web.notify.js_off"
msgid "Notifications turned off for this server."
msgstr "Powiadomienia wyłączone dla tego serwera."

msgctxt "web.notify.js_error"
msgid "Could not save your preferences. Please try again."
msgstr "Nie udało się zapisać twoich preferencji. Spróbuj ponownie."

msgctxt "web.notify.js_pick_different"
msgid "Pick different start and end hours"
msgstr "Wybierz różne godziny rozpoczęcia i zakończenia"

msgctxt "web.notify.js_must_differ"
msgid "Start and end must differ."
msgstr "Początek i koniec muszą się różnić."

#, python-format
msgctxt "web.notify.js_range_max"
msgid "Range must be %(max)s hours or less."
msgstr "Zakres musi wynosić %(max)s godzin lub mniej."

#, python-format
msgctxt "web.notify.js_times_in"
msgid "Times shown in %(tz)s"
msgstr "Godziny pokazane w %(tz)s"

msgctxt "web.notify.js_times_local"
msgid "Times shown in your local timezone"
msgstr "Godziny pokazane w twojej lokalnej strefie czasowej"

msgctxt "web.notify.unit_hour"
msgid "hour"
msgstr "godzina"

msgctxt "web.notify.unit_hours"
msgid "hours"
msgstr "godzin"

msgctxt "web.motd.available"
msgid "Available placeholders"
msgstr "Dostępne symbole zastępcze"

msgctxt "web.motd.intro"
msgid "These tokens are replaced with each game's details when the message of the day is shown in a game post:"
msgstr "Te tokeny są zastępowane szczegółami każdej gry, gdy wiadomość dnia jest wyświetlana w poście gry:"

msgctxt "web.motd.game_id"
msgid "the game's SpellBot ID"
msgstr "ID gry w SpellBot"

msgctxt "web.motd.game_format"
msgid "the game's format (e.g. Commander)"
msgstr "format gry (np. Commander)"

msgctxt "web.motd.game_bracket"
msgid "the game's commander bracket"
msgstr "poziom Commander gry"

msgctxt "web.motd.game_start"
msgid "when the game starts (a Discord timestamp), or “pending”"
msgstr "kiedy gra się rozpoczyna (znacznik czasu Discord) lub „oczekująca”"

msgctxt "web.motd.player_names"
msgid "the players' names, in join order"
msgstr "imiona graczy w kolejności dołączania"

